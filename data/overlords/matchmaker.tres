display_name = "The Matchmaker"
color = Color(0.85098, 0.309804, 0.415686, 1)
talk_lines = Array[String](["Have you met anyone yet? No? I know someone.", "A good match is a village's best harvest.", "Your mother married well. Will you?", "Love is a ledger too, child. Balance it."])
